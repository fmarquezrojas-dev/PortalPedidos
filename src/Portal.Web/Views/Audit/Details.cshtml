@model Portal.Application.DTOs.Audit.AuditDetailDto

@using System
@using System.Text.Json
@using Portal.Web.Formatting

@{
    ViewData["Title"] = $"Evento de auditoría #{Model.Id}";

    string actorLabel = Model.ActorType == "System"
        ? "Proceso automático"
        : Model.ActorEmail
            ?? Model.ActorUserId
            ?? "Sin usuario asociado";

    string formattedJson = Model.SummaryJson;
    string? reason = null;

    try
    {
        using var document = JsonDocument.Parse(Model.SummaryJson);

        formattedJson = JsonSerializer.Serialize(
            document.RootElement,
            new JsonSerializerOptions
            {
                WriteIndented = true
            });

        if (document.RootElement.ValueKind == JsonValueKind.Object)
        {
            foreach (var property in document.RootElement.EnumerateObject())
            {
                if (string.Equals(
                        property.Name,
                        "reason",
                        StringComparison.OrdinalIgnoreCase) &&
                    property.Value.ValueKind == JsonValueKind.String)
                {
                    reason = property.Value.GetString();
                    break;
                }
            }
        }
    }
    catch (JsonException)
    {
        // Si un evento antiguo tiene JSON inválido,
        // se muestra el texto registrado.
    }

    Guid relatedId = Guid.Empty;

    bool hasRelatedGuid = Guid.TryParse(
        Model.EntityId,
        out relatedId);
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between
                align-items-center gap-3 mb-4">
        <div>
            <p class="section-kicker">TRAZABILIDAD</p>
            <h1 class="h3 mb-2">
                Evento de auditoría #@Model.Id
            </h1>

            <p class="text-muted mb-0 text-break">
                @AuditDisplay.Action(Model.Action)
            </p>
        </div>

        <a asp-controller="Audit"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Volver a auditoría
        </a>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white">
            <h2 class="h5 mb-0">Información del evento</h2>
        </div>

        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-md-3">Fecha · Perú</dt>
                <dd class="col-md-9">
                    @PortalDateTime.Format(Model.OccurredAtUtc)
                </dd>

                <dt class="col-md-3">Responsable</dt>
                <dd class="col-md-9 text-break">
                    @actorLabel
                </dd>

                <dt class="col-md-3">Tipo de responsable</dt>
                <dd class="col-md-9">
                    @AuditDisplay.Actor(Model.ActorType)
                </dd>

                <dt class="col-md-3">Identificador del usuario</dt>
                <dd class="col-md-9 text-break">
                    @(Model.ActorUserId ?? "No corresponde")
                </dd>

                <dt class="col-md-3">Acción</dt>
                <dd class="col-md-9 text-break">
                    @AuditDisplay.Action(Model.Action)
                </dd>

                <dt class="col-md-3">Entidad</dt>
                <dd class="col-md-9">
                    @AuditDisplay.Entity(Model.EntityType)
                </dd>

                <dt class="col-md-3">Identificador de entidad</dt>
                <dd class="col-md-9 text-break">
                    @Model.EntityId
                </dd>

                <dt class="col-md-3">Correlación</dt>
                <dd class="col-md-9 text-break">
                    @Model.CorrelationId
                </dd>
            </dl>

            @if (hasRelatedGuid &&
                 Model.EntityType == "OutboxMessage")
            {
                <div class="mt-3">
                    <a asp-controller="Integration"
                       asp-action="Details"
                       asp-route-id="@relatedId"
                       class="btn btn-outline-primary">
                        Ver integración relacionada
                    </a>
                </div>
            }
            else if (hasRelatedGuid &&
                     Model.EntityType == "SalesOrder")
            {
                <div class="mt-3">
                    <a asp-controller="Orders"
                       asp-action="Details"
                       asp-route-id="@relatedId"
                       class="btn btn-outline-primary">
                        Ver pedido relacionado
                    </a>
                </div>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(reason))
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white">
                <h2 class="h5 mb-0">Motivo registrado</h2>
            </div>

            <div class="card-body">
                <p class="mb-0 text-break"
                   style="white-space: pre-wrap;">@reason</p>
            </div>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <h2 class="h5 mb-0">Información técnica del evento</h2>
        </div>

        <div class="card-body">
            <p class="small text-muted">
                Información guardada cuando ocurrió el evento.
                Puede diferir del estado actual del pedido.
            </p>

            <details><summary class="mb-3">Ver datos originales registrados</summary>
            <p class="small">Código: <code>@Model.Action</code> · Entidad: <code>@Model.EntityType</code></p>
            <pre class="bg-light border rounded p-3 mb-0"
                 style="white-space: pre-wrap; overflow-wrap: anywhere;"><code>@formattedJson</code></pre></details>
        </div>
    </div>
</div>
