@model Portal.Web.Models.Customers.CustomerPortfolioDetailsViewModel

@using System
@using Portal.Web.Formatting

@{
    ViewData["Title"] = "Responsable comercial";

    var current = Model.Portfolio.CurrentAssignment;

    string encodedVersion = current is null
        ? string.Empty
        : Convert.ToBase64String(current.RowVersion);
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <p class="section-kicker">GESTIÓN DE CARTERA</p>
            <h1 class="h3 mb-1">Responsable comercial</h1>

            <p class="text-muted mb-0">
                Administra la asignación de este cliente a un vendedor.
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="CustomerPortfolio"
               asp-action="Index"
               class="btn btn-outline-primary">
                Ver cartera comercial
            </a>

            <a asp-controller="Customers"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Volver a clientes
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success" role="status">
            @successMessage
        </div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage

            <div class="small mt-2">
                La ficha muestra la información actual.
                Revisa los datos antes de enviar otra operación.
            </div>
        </div>
    }

    @if (Model.CanCreateOrders)
    {
        if (Model.Eligibility?.IsEligible == true)
        {
            <div class="mb-3"><a asp-controller="Orders" asp-action="Create"
                asp-route-customerId="@Model.Portfolio.CustomerId" class="btn btn-primary">Nuevo pedido para este cliente</a></div>
        }
        else
        {
            <div class="alert alert-warning" role="status">@(Model.Eligibility?.Message ?? "El cliente no está disponible para pedidos.")</div>
        }
    }
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between gap-3">
                <div>
                    <div class="small text-muted">Cliente</div>
                    <div class="h5 mb-1">@Model.Portfolio.CustomerName</div>
                    <div class="text-muted">@Model.Portfolio.CustomerCode</div>
                </div>

                <div>
                    @if (Model.Portfolio.CustomerIsActive)
                    {
                        <span class="badge bg-success">
                            Cliente activo
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">
                            Cliente inactivo
                        </span>
                    }
                </div>
            </div>

            <p class="small text-muted mb-0 mt-3">
                Los datos maestros del cliente provienen del ERP.
                Esta pantalla administra su responsable en el portal.
            </p>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white">
            <h2 class="h5 mb-0">Asignación actual</h2>
        </div>

        <div class="card-body">
            @if (current is null)
            {
                <div class="alert alert-warning mb-0" role="status">
                    Este cliente no tiene un responsable comercial asignado.
                </div>
            }
            else
            {
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="small text-muted">Vendedor</div>
                        <div class="fw-semibold">@current.SellerEmail</div>
                    </div>

                    <div class="col-md-6">
                        <div class="small text-muted">Equipo comercial</div>
                        <div class="fw-semibold">
                            @current.TeamCode — @current.TeamName
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="small text-muted">Asignado · Perú</div>
                        <div>
                            @PortalDateTime.Format(current.AssignedAtUtc)
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="small text-muted">Asignado por</div>
                        <div>@current.AssignedByEmail</div>
                    </div>

                    <div class="col-12">
                        <div class="small text-muted">Motivo</div>
                        <div class="text-break">
                            @current.AssignmentReason
                        </div>
                    </div>
                </div>

                @if (current.IsOperational && Model.Portfolio.CustomerIsActive)
                {
                    <div class="alert alert-success mt-3 mb-0" role="status">
                        El responsable, su membresía, su equipo y el cliente
                        se encuentran activos.
                    </div>
                }
                else
                {
                    <div class="alert alert-warning mt-3 mb-0" role="status">
                        <div class="fw-semibold mb-2">
                            La asignación requiere revisión
                        </div>

                        <ul class="mb-0">
                            @if (!Model.Portfolio.CustomerIsActive)
                            {
                                <li>El cliente está inactivo en el catálogo.</li>
                            }

                            @if (!current.SellerIsActive)
                            {
                                <li>La cuenta del vendedor está inactiva.</li>
                            }

                            @if (!current.SellerHasRole)
                            {
                                <li>La cuenta ya no tiene el rol Vendedor.</li>
                            }

                            @if (!current.MembershipIsActive)
                            {
                                <li>El vendedor ya no pertenece a esta membresía del equipo.</li>
                            }

                            @if (!current.TeamIsActive)
                            {
                                <li>El equipo comercial está inactivo.</li>
                            }
                        </ul>
                    </div>
                }
            }
        </div>
    </div>

    @if (Model.Portfolio.CustomerIsActive)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white">
                <h2 class="h5 mb-0">
                    @(current is null
                        ? "Asignar responsable"
                        : "Cambiar responsable")
                </h2>
            </div>

            <div class="card-body">
                <p class="text-muted">
                    El vendedor debe tener una cuenta activa, el rol Vendedor
                    y una membresía vigente en un equipo activo.
                </p>

                <form asp-controller="CustomerPortfolio"
                      asp-action="Assign"
                      asp-antiforgery="true"
                      method="post">

                    <input type="hidden"
                           name="CustomerId"
                           value="@Model.Portfolio.CustomerId" />

                    <input type="hidden"
                           name="ExpectedAssignmentId"
                           value="@(current?.Id)" />

                    <input type="hidden"
                           name="ExpectedRowVersion"
                           value="@encodedVersion" />

                    <div class="mb-3">
                        <label for="seller-email" class="form-label">
                            Correo del vendedor
                        </label>

                        <input id="seller-email"
                               name="SellerEmail"
                               type="email"
                               maxlength="256"
                               required
                               class="form-control"
                               placeholder="vendedor@empresa.com" />
                    </div>

                    <div class="mb-3">
                        <label for="assignment-reason" class="form-label">
                            Motivo de la asignación o cambio
                        </label>

                        <textarea id="assignment-reason"
                                  name="Reason"
                                  minlength="5"
                                  maxlength="250"
                                  rows="3"
                                  required
                                  class="form-control"></textarea>

                        <div class="form-text">
                            Entre 5 y 250 caracteres.
                            El motivo quedará registrado en el historial.
                        </div>
                    </div>

                    @if (current is not null)
                    {
                        <p class="small text-muted">
                            Si seleccionas otro responsable, se cerrará
                            la asignación anterior. Los pedidos existentes
                            conservarán su propietario y equipo.
                        </p>
                    }

                    <button type="submit" class="btn btn-primary">
                        Guardar responsable
                    </button>
                </form>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning mb-4" role="status">
            No se puede asignar un nuevo responsable mientras el cliente
            esté inactivo. Su estado se actualiza mediante la sincronización
            con el ERP.
        </div>
    }

    @if (current is not null)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white">
                <h2 class="h5 mb-0">Retirar asignación</h2>
            </div>

            <div class="card-body">
                <p class="text-muted">
                    El cliente quedará sin responsable comercial.
                    Se conservarán el historial y los pedidos registrados.
                </p>

                <form asp-controller="CustomerPortfolio"
                      asp-action="Release"
                      asp-antiforgery="true"
                      method="post">

                    <input type="hidden"
                           name="CustomerId"
                           value="@Model.Portfolio.CustomerId" />

                    <input type="hidden"
                           name="ExpectedAssignmentId"
                           value="@current.Id" />

                    <input type="hidden"
                           name="ExpectedRowVersion"
                           value="@encodedVersion" />

                    <div class="mb-3">
                        <label for="release-reason" class="form-label">
                            Motivo del retiro
                        </label>

                        <textarea id="release-reason"
                                  name="Reason"
                                  minlength="5"
                                  maxlength="250"
                                  rows="3"
                                  required
                                  class="form-control"></textarea>
                    </div>

                    <div class="form-check mb-3">
                        <input id="confirm-release"
                               name="ConfirmRelease"
                               type="checkbox"
                               value="true"
                               required
                               class="form-check-input" />

                        <label for="confirm-release"
                               class="form-check-label">
                            Confirmo que deseo dejar al cliente
                            sin responsable comercial.
                        </label>
                    </div>

                    <button type="submit"
                            class="btn btn-outline-danger">
                        Retirar asignación
                    </button>
                </form>
            </div>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <h2 class="h5 mb-0">Historial de asignaciones cerradas</h2>
        </div>

        <div class="card-body">
            <p class="small text-muted">
                Se muestran las últimas @Model.Portfolio.History.Count
                de @Model.Portfolio.ClosedAssignmentCount asignaciones cerradas.
            </p>

            @if (Model.Portfolio.History.Count == 0)
            {
                <p class="text-muted mb-0">
                    Todavía no hay asignaciones cerradas.
                </p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">Responsable y equipo</th>
                                <th scope="col">Inicio · Perú</th>
                                <th scope="col">Cierre · Perú</th>
                                <th scope="col">Motivos</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var entry in Model.Portfolio.History)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">
                                            @entry.SellerEmail
                                        </div>

                                        <div class="small text-muted">
                                            @entry.TeamCode — @entry.TeamName
                                        </div>
                                    </td>

                                    <td>
                                        <div class="text-nowrap">
                                            @PortalDateTime.Format(entry.AssignedAtUtc)
                                        </div>

                                        <div class="small text-muted">
                                            @entry.AssignedByEmail
                                        </div>
                                    </td>

                                    <td>
                                        <div class="text-nowrap">
                                            @PortalDateTime.Format(entry.EndedAtUtc)
                                        </div>

                                        <div class="small text-muted">
                                            @entry.EndedByEmail
                                        </div>
                                    </td>

                                    <td class="text-break">
                                        <div>
                                            <strong>Asignación:</strong>
                                            @entry.AssignmentReason
                                        </div>

                                        <div class="mt-1">
                                            <strong>Cierre:</strong>
                                            @entry.EndReason
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
