@model Portal.Application.DTOs.Dashboard.DashboardDto

@using System.Globalization
@using Portal.Domain.Enums
@using Portal.Web.Formatting

@{
    ViewData["Title"] = "Resumen";
    string Share(int count) => Model.TotalOrders > 0
        ? (100m * count / Model.TotalOrders).ToString("0.###", CultureInfo.InvariantCulture)
        : "0";

    var culture = CultureInfo.GetCultureInfo("es-PE");

    string scopeLabel = Model.ShowsAllOrders
        ? "Todos los pedidos del portal"
        : Model.ShowsTeamOrders
            ? "Tus pedidos y los de los equipos activos que supervisas"
            : "Pedidos registrados con tu cuenta";

    string catalogLabel = !Model.CatalogAvailable
        ? "Sin sincronización"
        : Model.CatalogIsStale
            ? "Requiere actualización"
            : "Actualizado";

    string catalogBadgeClass =
        Model.CatalogAvailable && !Model.CatalogIsStale
            ? "bg-success"
            : "bg-warning text-dark";

    string catalogAgeLabel =
        !Model.CatalogAgeMinutes.HasValue
            ? "Sin información"
            : Model.CatalogAgeMinutes.Value == 0
                ? "Menos de un minuto"
                : $"{Model.CatalogAgeMinutes.Value} min";
}

<div class="container-fluid py-4">
    <div class="dashboard-hero d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <p class="eyebrow">PANORAMA COMERCIAL</p>
            <h1 class="h3 mb-2">Tu operación, de un vistazo.</h1>

            <p class="text-muted mb-1">
                @scopeLabel
            </p>

            <div class="small text-muted">
                Consulta realizada:
                @PortalDateTime.Format(Model.GeneratedAtUtc)
                · Perú
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Dashboard"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Actualizar resumen
            </a>

            @if (Model.CanCreateOrders)
            {
                <a asp-controller="Orders"
                   asp-action="Create"
                   class="btn btn-primary">
                    Nuevo pedido
                </a>
            }
        </div>
    </div>

    @if (Model.ShowsTeamOrders && !Model.ShowsAllOrders)
    {
        <div class="alert alert-info mb-4" role="status">
            <div class="fw-semibold mb-1">
                Resumen comercial de tus equipos
            </div>

            <p class="mb-2">
                Los indicadores incluyen tus pedidos y los atribuidos
                a los equipos activos que supervisas.
            </p>

            <p class="small mb-3">
                Los pedidos anteriores sin equipo asignado solo se
                incluyen cuando pertenecen a tu cuenta.
            </p>

            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="Teams"
                   asp-action="Index"
                   class="btn btn-sm btn-outline-primary">
                    Consultar mis equipos
                </a>

                <a asp-controller="Orders"
                   asp-action="Index"
                   class="btn btn-sm btn-outline-primary">
                    Consultar pedidos
                </a>
            </div>
        </div>
    }

    <div class="d-flex flex-wrap justify-content-between gap-2 mb-3">
        <h2 class="h5 mb-0">Pedidos</h2>

        <span class="small text-muted">
            Acumulado de todos los períodos
        </span>
    </div>

    <div class="row g-3 mb-4 dashboard-metrics">
        <div class="col-6 col-lg-4 col-xl-2">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="small text-muted mb-2">
                        Total
                    </div>

                    <div class="h2 mb-3">
                        @Model.TotalOrders.ToString("N0", culture)
                    </div>

                    <a asp-controller="Orders"
                       asp-action="Index"
                       class="small">
                        Ver pedidos
                    </a>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-4 col-xl-2">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="small text-muted mb-2">
                        Borradores
                    </div>

                    <div class="h2 mb-3">
                        @Model.DraftOrders.ToString("N0", culture)
                    </div>

                    <a asp-controller="Orders"
                       asp-action="Index"
                       asp-route-status="@OrderStatus.Draft"
                       class="small">
                        Ver borradores
                    </a>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-4 col-xl-2">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="small text-muted mb-2">
                        Por confirmar
                    </div>

                    <div class="h2 mb-3">
                        @Model.QueuedOrders.ToString("N0", culture)
                    </div>

                    <a asp-controller="Orders"
                       asp-action="Index"
                       asp-route-status="@OrderStatus.Queued"
                       class="small">
                        Ver pendientes
                    </a>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-4 col-xl-2">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="small text-muted mb-2">
                        Confirmados
                    </div>

                    <div class="h2 text-success mb-3">
                        @Model.ConfirmedOrders.ToString("N0", culture)
                    </div>

                    <a asp-controller="Orders"
                       asp-action="Index"
                       asp-route-status="@OrderStatus.Confirmed"
                       class="small">
                        Ver confirmados
                    </a>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-4 col-xl-2">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="small text-muted mb-2">
                        Rechazados
                    </div>

                    <div class="h2 text-danger mb-3">
                        @Model.RejectedOrders.ToString("N0", culture)
                    </div>

                    <a asp-controller="Orders"
                       asp-action="Index"
                       asp-route-status="@OrderStatus.Rejected"
                       class="small">
                        Ver rechazados
                    </a>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-4 col-xl-2">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="small text-muted mb-2">
                        Cancelados
                    </div>

                    <div class="h2 mb-3">
                        @Model.CancelledOrders.ToString("N0", culture)
                    </div>

                    <a asp-controller="Orders"
                       asp-action="Index"
                       asp-route-status="@OrderStatus.Cancelled"
                       class="small">
                        Ver cancelados
                    </a>
                </div>
            </div>
        </div>
    </div>

    @if (Model.TotalOrders > 0)
    {
        <section class="card mb-4" aria-labelledby="distribution-title">
            <div class="card-body">
                <div class="d-flex justify-content-between flex-wrap gap-2 mb-3"><h2 id="distribution-title" class="h6 mb-0">Distribución de pedidos</h2><span class="small text-muted">Acumulado según tu acceso</span></div>
                <div class="order-distribution" aria-hidden="true">
                    <span class="distribution-draft" style="width:@(Share(Model.DraftOrders))%"></span>
                    <span class="distribution-queued" style="width:@(Share(Model.QueuedOrders))%"></span>
                    <span class="distribution-confirmed" style="width:@(Share(Model.ConfirmedOrders))%"></span>
                    <span class="distribution-rejected" style="width:@(Share(Model.RejectedOrders))%"></span>
                    <span class="distribution-cancelled" style="width:@(Share(Model.CancelledOrders))%"></span>
                </div>
                <div class="distribution-legend">
                    <span><i class="legend-dot distribution-draft" aria-hidden="true"></i>Borradores · @Model.DraftOrders.ToString("N0", culture)</span>
                    <span><i class="legend-dot distribution-queued" aria-hidden="true"></i>Por confirmar · @Model.QueuedOrders.ToString("N0", culture)</span>
                    <span><i class="legend-dot distribution-confirmed" aria-hidden="true"></i>Confirmados · @Model.ConfirmedOrders.ToString("N0", culture)</span>
                    <span><i class="legend-dot distribution-rejected" aria-hidden="true"></i>Rechazados · @Model.RejectedOrders.ToString("N0", culture)</span>
                    <span><i class="legend-dot distribution-cancelled" aria-hidden="true"></i>Cancelados · @Model.CancelledOrders.ToString("N0", culture)</span>
                </div>
            </div>
        </section>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h2 class="h5 mb-0">Estado del catálogo</h2>

            <span class="badge @catalogBadgeClass">
                @catalogLabel
            </span>
        </div>

        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="small text-muted">
                        Última sincronización correcta · Perú
                    </div>

                    <div class="fw-semibold">
                        @(Model.CatalogLastSuccessAtUtc.HasValue
                            ? PortalDateTime.Format(
                                Model.CatalogLastSuccessAtUtc)
                            : "Todavía no registrada")
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="small text-muted">
                        Antigüedad
                    </div>

                    <div class="fw-semibold">
                        @catalogAgeLabel
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="small text-muted">
                        Versión del catálogo
                    </div>

                    <div class="fw-semibold">
                        @Model.CatalogVersion
                    </div>
                </div>
            </div>

            @if (!Model.CatalogAvailable)
            {
                <div class="alert alert-warning mt-3 mb-0"
                     role="status">
                    Se necesita una sincronización correcta
                    para disponer del catálogo del ERP.
                </div>
            }
            else if (Model.CatalogIsStale)
            {
                <div class="alert alert-warning mt-3 mb-0"
                     role="status">
                    El catálogo no está vigente.
                    Los envíos requieren datos actualizados.
                    Revisa la sincronización antes de enviar pedidos.
                </div>
            }
            else
            {
                <p class="small text-muted mt-3 mb-0">
                    Las existencias son informativas.
                    El ERP valida y reserva la disponibilidad
                    definitiva cuando acepta el pedido.
                </p>
            }

            @if (Model.ShowsAllOrders &&
                 !string.IsNullOrWhiteSpace(Model.CatalogLastErrorCode))
            {
                <div class="alert alert-warning mt-3 mb-0"
                     role="status">
                    <strong>
                        Se registró un error de sincronización:
                    </strong>

                    <span class="text-break">
                        @Model.CatalogLastErrorCode
                    </span>

                    <div class="small mt-1">
                        La fecha mostrada corresponde
                        a la última sincronización correcta.
                    </div>
                </div>
            }

            <div class="mt-3">
                <a asp-controller="Catalog"
                   asp-action="Index"
                   class="btn btn-outline-primary">
                    Abrir catálogo
                </a>
            </div>
        </div>
    </div>

    @if (Model.ShowsAllOrders)
    {
        <div class="mb-4">
            <h2 class="h5 mb-3">Seguimiento de integraciones</h2>

            <div class="row g-3">
                <div class="col-md-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <div class="small text-muted mb-2">
                                En procesamiento o espera
                            </div>

                            <div class="h2 mb-2">
                                @Model.ActiveIntegrationMessages.ToString("N0", culture)
                            </div>

                            <p class="small text-muted mb-0">
                                Incluye pendientes, procesamiento,
                                reintentos y consultas del resultado.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <div class="small text-muted mb-2">
                                Resultado por verificar
                            </div>

                            <div class="h2 mb-2">
                                @Model.UnknownIntegrationMessages.ToString("N0", culture)
                            </div>

                            <p class="small text-muted">
                                Incluidos en el indicador
                                de procesamiento o espera.
                            </p>

                            <a asp-controller="Integration"
                               asp-action="Index"
                               asp-route-status="@IntegrationStatus.Unknown"
                               class="small">
                                Revisar consultas pendientes
                            </a>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <div class="small text-muted mb-2">
                                Requieren revisión
                            </div>

                            <div class="h2 mb-2">
                                @Model.DeadLetterIntegrationMessages.ToString("N0", culture)
                            </div>

                            <p class="small text-muted">
                                El procesamiento automático
                                se encuentra detenido.
                            </p>

                            <a asp-controller="Integration"
                               asp-action="Index"
                               asp-route-status="@IntegrationStatus.DeadLetter"
                               class="small">
                                Revisar incidencias
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            @if (Model.OverdueIntegrationMessages > 0)
            {
                <div class="alert alert-warning mt-3 mb-0"
                     role="status">
                    <strong>
                        @Model.OverdueIntegrationMessages.ToString("N0", culture)
                        integración(es) sin resolver desde hace
                        más de cinco minutos.
                    </strong>

                    <p class="mb-2 mt-2">
                        Incluye operaciones que todavía se procesan
                        y operaciones detenidas que requieren revisión.
                    </p>

                    @if (Model.OldestUnresolvedMessageAtUtc.HasValue)
                    {
                        <div class="small mb-2">
                            Pendiente más antiguo · Perú:
                            @PortalDateTime.Format(
                                Model.OldestUnresolvedMessageAtUtc)
                        </div>
                    }

                    <a asp-controller="Integration"
                       asp-action="Index"
                       class="alert-link">
                        Abrir monitor de integraciones
                    </a>
                </div>
            }

            <div class="mt-3">
                <a asp-controller="Integration"
                   asp-action="Index"
                   class="btn btn-outline-primary">
                    Ver todas las integraciones
                </a>
            </div>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h2 class="h5 mb-0">Últimos pedidos creados</h2>

            <a asp-controller="Orders"
               asp-action="Index"
               class="btn btn-sm btn-outline-primary">
                Ver todos
            </a>
        </div>

        <div class="card-body">
            @if (Model.RecentOrders.Count == 0)
            {
                <div class="text-center py-4">
                    <h3 class="h6">
                        Todavía no hay pedidos para mostrar
                    </h3>

                    <p class="text-muted mb-0">
                        Los pedidos que puedas consultar
                        aparecerán en este resumen.
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">Pedido</th>
                                <th scope="col">Cliente</th>
                                <th scope="col">Creado · Perú</th>
                                <th scope="col">Estado</th>

                                <th scope="col" class="text-end">
                                    Importe ref.
                                </th>

                                <th scope="col" class="text-end">
                                    Acción
                                </th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var order in Model.RecentOrders)
                            {
                                <tr>
                                    <td class="fw-semibold text-nowrap">
                                        #@order.PublicNumber
                                    </td>

                                    <td>
                                        @order.CustomerName
                                    </td>

                                    <td class="text-nowrap">
                                        @PortalDateTime.Format(order.CreatedAtUtc)
                                    </td>

                                    <td>
                                        <partial name="_OrderStatus"
                                                 model="order.Status" />
                                    </td>

                                    <td class="text-end text-nowrap">
                                        @order.Currency
                                        @order.Subtotal.ToString("N2", culture)
                                    </td>

                                    <td class="text-end">
                                        <a asp-controller="Orders"
                                           asp-action="Details"
                                           asp-route-id="@order.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Ver detalle
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <p class="small text-muted mt-3 mb-0">
                    Importes referenciales sin impuestos.
                    Se muestran como máximo diez pedidos.
                </p>
            }
        </div>
    </div>
</div>