@using Microsoft.AspNetCore.Authorization
@using Portal.Infrastructure.Identity
@using Portal.Web.Security
@inject IAuthorizationService AuthorizationService
@{
    ViewData["Title"] = "Mi espacio";
    bool canViewOrders = (await AuthorizationService.AuthorizeAsync(User, AppPolicies.ViewOrders)).Succeeded;
    bool canCreateOrders = (await AuthorizationService.AuthorizeAsync(User, AppPolicies.CreateOrders)).Succeeded;
    bool canViewTeams = (await AuthorizationService.AuthorizeAsync(User, AppPolicies.ViewTeams)).Succeeded;
    bool canOperate = User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Operator);
    string[] roles = { AppRoles.Admin, AppRoles.Seller, AppRoles.SalesSupervisor, AppRoles.Operator, AppRoles.CommercialManagement, AppRoles.Auditor };
}
<div>
    <section class="home-welcome">
        <h1>Mi espacio comercial</h1>
        <div class="d-flex flex-wrap gap-2">
            @if (canViewOrders) { <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">Abrir resumen <partial name="_Icon" model='@("arrow")' /></a> }
            @if (canCreateOrders) { <a asp-controller="Orders" asp-action="Create" class="btn btn-outline-primary">Crear un pedido</a> }
        </div>
    </section>
    <div class="d-flex justify-content-between mb-3"><h2 class="h5">Accesos de tu cuenta</h2><span class="small text-muted">Según tus permisos</span></div>
    <div class="row g-3 mb-4">
        @if (canViewOrders)
        {
            <div class="col-md-6"><a class="quick-link" asp-controller="Orders" asp-action="Index"><partial name="_Icon" model='@("orders")' /><span><strong>Pedidos</strong><small>Consulta borradores, envíos y resultados.</small></span><partial name="_Icon" model='@("arrow")' /></a></div>
            <div class="col-md-6"><a class="quick-link" asp-controller="Customers" asp-action="Index"><partial name="_Icon" model='@("users")' /><span><strong>Clientes</strong><small>Encuentra a tu cliente y prepara su pedido.</small></span><partial name="_Icon" model='@("arrow")' /></a></div>
        }
            <div class="col-md-6"><a class="quick-link" asp-controller="Catalog" asp-action="Index"><partial name="_Icon" model='@("box")' /><span><strong>Catálogo</strong><small>Consulta productos, precios y existencias.</small></span><partial name="_Icon" model='@("arrow")' /></a></div>
        @if (canViewTeams) { <div class="col-md-6"><a class="quick-link" asp-controller="Teams" asp-action="Index"><partial name="_Icon" model='@("briefcase")' /><span><strong>Equipos comerciales</strong><small>Revisa equipos y miembros disponibles.</small></span><partial name="_Icon" model='@("arrow")' /></a></div> }
        @if (canOperate) { <div class="col-md-6"><a class="quick-link" asp-controller="Integration" asp-action="Attention"><partial name="_Icon" model='@("link")' /><span><strong>Atención operativa</strong><small>Revisa los pedidos que esperan un resultado del ERP.</small></span><partial name="_Icon" model='@("arrow")' /></a></div> }
    </div>
    <section class="card"><div class="card-body"><h2 class="h5 mb-3">Tu sesión</h2><div class="row g-3"><div class="col-md-6"><p class="small text-muted mb-1">Cuenta</p><strong class="text-break">@User.Identity?.Name</strong></div><div class="col-md-6"><p class="small text-muted mb-1">Roles asignados</p>@foreach (string role in roles.Where(User.IsInRole)) { <span class="badge bg-primary me-1 mb-1">@role</span> }</div></div></div></section>
</div>
