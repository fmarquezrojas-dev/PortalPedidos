@model Portal.Web.Models.Orders.CopyRejectedOrderViewModel

@using System.Globalization

@{
    ViewData["Title"] = "Copiar pedido rechazado";

    var culture = CultureInfo.GetCultureInfo("es-PE");
    var preview = Model.Preview;

    string minimumDate = preview.TodayInPeru.ToString(
        "yyyy-MM-dd",
        CultureInfo.InvariantCulture);
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between
                align-items-center gap-3 mb-4">
        <div>
            <p class="section-kicker">NUEVO BORRADOR</p>
            <h1 class="h3 mb-2">Crear copia como borrador</h1>

            <p class="text-muted mb-0">
                Pedido original:
                #@preview.SourcePublicNumber
            </p>
        </div>

        <a asp-controller="Orders"
           asp-action="Details"
           asp-route-id="@Model.SourceOrderId"
           class="btn btn-outline-secondary">
            Volver al pedido original
        </a>
    </div>

    <div asp-validation-summary="All"
         class="text-danger mb-3"
         role="alert"></div>

    <div class="alert alert-info">
        El pedido rechazado conservará sus datos e historial.
        La copia tendrá un nuevo número y se guardará como borrador.
        No se enviará al ERP al confirmar esta pantalla.
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-8">
                    <div class="small text-muted">Cliente actual</div>

                    <div class="fw-semibold">
                        @preview.CustomerName
                    </div>

                    <div class="small text-muted">
                        @preview.CustomerCode
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="small text-muted">
                        Versión del catálogo revisada
                    </div>

                    <div class="fw-semibold">
                        @preview.CatalogVersion
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (preview.Problems.Count > 0)
    {
        <div class="alert alert-warning" role="alert">
            <p class="fw-semibold">
                Hay condiciones que impiden crear la copia:
            </p>

            <ul class="mb-0">
                @foreach (var problem in preview.Problems)
                {
                    <li>@problem</li>
                }
            </ul>
        </div>
    }

    @if (preview.PricesChanged)
    {
        <div class="alert alert-warning" role="status">
            Hay precios distintos de los del pedido original.
            Revisa la columna de precio actual antes de confirmar.
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white">
            <h2 class="h5 mb-0">Productos de la copia</h2>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th scope="col">Producto</th>
                            <th scope="col" class="text-end">Cantidad</th>
                            <th scope="col" class="text-end">
                                Precio original
                            </th>
                            <th scope="col" class="text-end">
                                Precio actual
                            </th>
                            <th scope="col" class="text-end">
                                Importe actual
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var line in preview.Lines)
                        {
                            bool priceChanged =
                                line.CurrentUnitPrice.HasValue &&
                                line.CurrentUnitPrice.Value !=
                                    line.OriginalUnitPrice;

                            <tr>
                                <td>
                                    <div>@line.Description</div>

                                    <div class="small text-muted">
                                        @line.ItemCode
                                    </div>

                                    @if (priceChanged)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Precio actualizado
                                        </span>
                                    }
                                </td>

                                <td class="text-end">
                                    @line.Quantity.ToString(
                                        "0.####",
                                        culture)
                                </td>

                                <td class="text-end text-nowrap">
                                    @line.OriginalUnitPrice.ToString(
                                        "0.00##",
                                        culture)
                                </td>

                                <td class="text-end text-nowrap">
                                    @(line.CurrentUnitPrice.HasValue
                                        ? line.CurrentUnitPrice.Value.ToString(
                                            "0.00##",
                                            culture)
                                        : "No disponible")
                                </td>

                                <td class="text-end text-nowrap">
                                    @(line.CurrentLineAmount.HasValue
                                        ? line.CurrentLineAmount.Value.ToString(
                                            "N2",
                                            culture)
                                        : "—")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="text-end mt-3">
                <div class="small text-muted">
                    Importe original:
                    @preview.Currency
                    @preview.OriginalSubtotal.ToString("N2", culture)
                </div>

                @if (preview.CanCopy)
                {
                    <div class="h4 mt-2 mb-1">
                        Nuevo importe:
                        @preview.Currency
                        @preview.NewSubtotal.ToString("N2", culture)
                    </div>
                }
                else
                {
                    <div class="mt-2">
                        El total de la copia requiere resolver
                        las observaciones.
                    </div>
                }

                <div class="small text-muted">
                    Importes referenciales sin impuestos
                </div>
            </div>
        </div>
    </div>

    @if (Model.RequiresReload)
    {
        <div class="alert alert-warning">
            Recarga la revisión antes de volver a confirmar.
            Se conservará el identificador de esta copia.
        </div>
    }

    @if (preview.CanCopy && !Model.RequiresReload)
    {
        <form asp-controller="OrderCopies"
              asp-action="Create"
              asp-route-id="@Model.SourceOrderId"
              asp-antiforgery="true"
              method="post">

            <input asp-for="SourceOrderId" type="hidden" />
            <input asp-for="DraftId" type="hidden" />
            <input asp-for="CatalogVersion" type="hidden" />

            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-5">
                            <label asp-for="RequestedDate"
                                   class="form-label"></label>

                            <input asp-for="RequestedDate"
                                   asp-format="{0:yyyy-MM-dd}"
                                   type="date"
                                   min="@minimumDate"
                                   required
                                   class="form-control" />

                            <span asp-validation-for="RequestedDate"
                                  class="text-danger"></span>
                        </div>
                    </div>

                    <p class="small text-muted mt-3 mb-0">
                        La disponibilidad se comprobará al enviar
                        el nuevo pedido. Crear este borrador
                        no reserva existencias.
                    </p>
                </div>
            </div>

            <div class="form-check mb-3">
                <input asp-for="ConfirmCopy"
                       class="form-check-input"
                       required />

                <label asp-for="ConfirmCopy"
                       class="form-check-label">
                    Revisé el cliente, las cantidades, los precios
                    actuales y la fecha. Confirmo la creación
                    del nuevo borrador.
                </label>

                <span asp-validation-for="ConfirmCopy"
                      class="text-danger d-block"></span>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary">
                    Crear nuevo borrador
                </button>

                <a asp-controller="Orders"
                   asp-action="Details"
                   asp-route-id="@Model.SourceOrderId"
                   class="btn btn-outline-secondary">
                    Volver sin crear copia
                </a>
            </div>
        </form>
    }

    <div class="mt-3">
        <a asp-controller="OrderCopies"
           asp-action="Index"
           asp-route-id="@Model.SourceOrderId"
           asp-route-draftId="@Model.DraftId">
            Recargar revisión
        </a>
    </div>
</div>