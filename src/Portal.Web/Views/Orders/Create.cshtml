@model Portal.Web.Models.Orders.CreateOrderViewModel

@using System.Globalization
@using System.Linq
@using Portal.Application.DTOs.Orders

@{
    var culture = CultureInfo.GetCultureInfo("es-PE");

    string pageTitle = Model.IsEdit
        ? $"Editar pedido #{Model.PublicNumber}"
        : "Nuevo pedido";

    ViewData["Title"] = pageTitle;

    string formAction = Model.IsEdit ? "Edit" : "Create";

    string returnAction = Model.IsEdit ? "Details" : "Index";

    string? orderRouteId = Model.IsEdit
        ? Model.DraftId.ToString()
        : null;

    string minimumDate = Model.FormData.TodayInPeru.ToString(
        "yyyy-MM-dd",
        CultureInfo.InvariantCulture);

    string savedSubtotal = Model.SavedSubtotal.HasValue
        ? Model.SavedSubtotal.Value.ToString("N2", culture)
        : "Sin registro";

    var selectedProducts = Model.FormData.Products.ToDictionary(p => p.Id);
    var customer = Model.FormData.Customer;
    bool selectedCustomerUnavailable = Model.CustomerId.HasValue && !Model.FormData.CustomerIsEligible;
}

<div class="container-fluid py-4">
    <p class="section-kicker">PREPARACIÓN DEL PEDIDO</p>
    <div class="order-form-heading mb-2"><h1 class="h3 mb-0">@pageTitle</h1><span class="badge bg-secondary">Borrador · Sin enviar</span></div>

    <p class="text-muted mb-4">
        @if (Model.IsEdit)
        {
            <text>
                Modifica el borrador y revisa los precios actuales
                antes de guardar.
            </text>
        }
        else
        {
            <text>
                Guarda un borrador para preparar el pedido.
                Las existencias se validarán al enviarlo al ERP.
            </text>
        }
    </p>

    @if (selectedCustomerUnavailable)
    {
        <div class="alert alert-warning" role="alert">
            <p class="fw-semibold mb-1">
                El cliente seleccionado ya no está disponible para pedidos.
            </p>
            <p class="mb-0">
                Selecciona un cliente habilitado antes de guardar.
                @if (Model.IsEdit)
                {
                    <text>
                        El borrador guardado se conserva; abrir este formulario
                        no cambia su cliente ni sus líneas.
                    </text>
                }
            </p>
        </div>
    }

    @if (Model.FormData.CatalogVersion <= 0)
    {
        <div class="alert alert-warning" role="alert">Para guardar necesitas un catálogo sincronizado.</div>
    }
    <noscript><div class="alert alert-info">Activa JavaScript para buscar clientes y productos, agregar líneas y calcular el importe. El servidor volverá a validar los datos al guardar.</div></noscript>
    <form id="create-order-form"
          data-customer-url="@Url.Action("SearchCustomers")"
          data-product-url="@Url.Action("SearchProducts")"
          asp-controller="Orders"
          asp-action="@formAction"
          asp-route-id="@orderRouteId"
          asp-antiforgery="true"
          method="post">

        <input asp-for="DraftId" type="hidden" />
        <input asp-for="CatalogVersion" type="hidden" />
        <input asp-for="RowVersion" type="hidden" />

        <div asp-validation-summary="All"
             class="text-danger mb-3"
             role="alert"></div>

        @if (Model.IsEdit)
        {
            <div class="alert alert-info">
                <p class="mb-2">
                    Importe guardado antes de esta edición:
                    <strong>PEN @savedSubtotal</strong>
                </p>

                <p class="mb-2">
                    El formulario muestra los precios actuales
                    del catálogo. Al guardar, estos precios se
                    aplicarán a las líneas del borrador.
                </p>

                <a asp-controller="Orders"
                   asp-action="Edit"
                   asp-route-id="@Model.DraftId"
                   class="alert-link">
                    Recargar pedido y descartar cambios sin guardar
                </a>
            </div>
        }

        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h2 class="order-step-heading"><span class="step-number">01</span> Cliente y fecha solicitada</h2>
                <div class="row g-3">
                    <div class="col-md-8">
                        <label for="customer-search" class="form-label">Buscar cliente por código o nombre</label>
                        <input id="customer-search" class="form-control capture-search" type="search"
                               maxlength="100" autocomplete="off" aria-controls="CustomerId" aria-describedby="customer-search-status" />
                        <label asp-for="CustomerId" class="visually-hidden">Cliente del pedido</label>
                        <select asp-for="CustomerId" class="form-select mt-1" required
                                aria-describedby="customer-search-status">
                            <option value="">Selecciona un cliente</option>
                            @if (Model.CustomerId is Guid customerId)
                            {
                                <option value="@customerId" data-unavailable="@(!Model.FormData.CustomerIsEligible ? "true" : null)">@(customer is null ? customerId.ToString() : $"{customer.Code} - {customer.Name}")</option>
                            }
                        </select>
                        <small id="customer-search-status" class="form-text search-status" role="status"></small>
                        <span asp-validation-for="CustomerId" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="RequestedDate"
                               class="form-label"></label>

                        <input asp-for="RequestedDate"
                               asp-format="{0:yyyy-MM-dd}"
                               type="date"
                               min="@minimumDate"
                               class="form-control"
                               required />

                        <span asp-validation-for="RequestedDate"
                              class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white d-flex flex-wrap
                        justify-content-between align-items-center gap-2">
                <h2 class="order-step-heading mb-0"><span class="step-number">02</span> Productos del pedido</h2>

                <button id="add-order-line"
                        type="button"
                        class="btn btn-sm btn-outline-primary">
                    Agregar producto
                </button>
            </div>

            <div class="card-body">
                <p class="small text-muted">
                    <span id="order-line-count">@Model.Lines.Count</span> de 100 líneas. Agrega productos distintos.
                    Las cantidades deben ser enteras entre 1 y 9999.
                </p>

                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th scope="col">Producto</th>

                                <th scope="col" style="width: 130px;">
                                    Cantidad
                                </th>

                                <th scope="col" class="text-end">
                                    Precio PEN
                                </th>

                                <th scope="col" class="text-end">
                                    Importe PEN
                                </th>

                                <th scope="col" class="text-end">
                                    Acción
                                </th>
                            </tr>
                        </thead>

                        <tbody id="order-lines">
                            @for (int i = 0; i < Model.Lines.Count; i++)
                            {
                                <tr class="order-line">
                                    <td>
                                        @{
                                            var id = Model.Lines[i].ProductId;
                                            ProductOptionDto? product = id.HasValue ? selectedProducts.GetValueOrDefault(id.Value) : null;
                                            var price = product?.UnitPrice.ToString("0.0000", CultureInfo.InvariantCulture);
                                        }
                                        <input type="search" class="form-control capture-search" maxlength="100"
                                               autocomplete="off" placeholder="Código o nombre" aria-label="Buscar producto de la línea @(i + 1)" />
                                        <select asp-for="Lines[i].ProductId" class="form-select mt-1 line-product" aria-label="Producto" required>
                                            <option value="">Selecciona un producto</option>
                                            @if (id.HasValue)
                                            {
                                                <option value="@id" data-price="@price" data-unavailable="@(product?.IsActive == true ? null : "true")">@(product is null ? id.ToString() : $"{product.Code} - {product.Name}")</option>
                                            }
                                        </select>
                                        <small class="form-text search-status" role="status"></small>
                                        <input type="hidden" class="quoted-price" name="Lines[@i].QuotedPrice" value="@price" />
                                        @if (id.HasValue)
                                        {
                                            <div class="small text-warning-emphasis product-review" data-product-id="@id">
                                                @if (product?.IsActive != true)
                                                {
                                                    <span>Producto no disponible. Sustitúyelo o quita esta línea.</span>
                                                }
                                                @if (Model.SavedPrices.TryGetValue(id.Value, out var savedPrice) && savedPrice != product?.UnitPrice)
                                                {
                                                    <span>Precio guardado PEN @savedPrice.ToString("0.0000", culture).</span>
                                                }
                                                @if (decimal.TryParse(Model.Lines[i].QuotedPrice, NumberStyles.AllowDecimalPoint, CultureInfo.InvariantCulture, out var quoted) && quoted != product?.UnitPrice)
                                                {
                                                    <span>Precio mostrado al enviar el formulario PEN @quoted.ToString("0.0000", culture).</span>
                                                }
                                            </div>
                                        }
                                    </td>

                                    <td>
                                        <input asp-for="Lines[i].Quantity"
                                               type="number"
                                               min="1"
                                               max="9999"
                                               step="1"
                                               required
                                               aria-label="Cantidad"
                                               class="form-control line-quantity" />
                                    </td>

                                    <td class="text-end text-nowrap line-price">
                                        —
                                    </td>

                                    <td class="text-end text-nowrap line-amount">
                                        —
                                    </td>

                                    <td class="text-end">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger remove-line">
                                            Quitar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="order-total mt-3">
                    <div class="text-muted">
                        Importe referencial sin impuestos
                    </div>

                    <div class="h4">
                        S/ <span id="order-subtotal">0.00</span>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.IsEdit)
        {
            <div class="form-check mb-3">
                <input asp-for="AcceptCurrentPrices"
                       class="form-check-input"
                       required />

                <label asp-for="AcceptCurrentPrices"
                       class="form-check-label">
                    He revisado los precios actuales y el importe.
                </label>

                <div>
                    <span asp-validation-for="AcceptCurrentPrices"
                          class="text-danger"></span>
                </div>
            </div>
        }

        <p class="small text-muted">
            Guardar el borrador no reserva existencias ni envía
            el pedido al ERP.
        </p>

        <div class="order-actions d-flex flex-wrap gap-2">
            <button id="save-draft"
                    type="submit"
                    class="btn btn-primary">
                Guardar borrador
            </button>

            <a asp-controller="Orders"
               asp-action="@returnAction"
               asp-route-id="@orderRouteId"
               class="btn btn-outline-secondary">
                Salir sin guardar
            </a>
        </div>
    </form>

    <template id="order-line-template">
        <tr class="order-line">
            <td>
                <input type="search" class="form-control capture-search" maxlength="100"
                       autocomplete="off" placeholder="Código o nombre" aria-label="Buscar producto" />
                <select class="form-select mt-1 line-product" aria-label="Producto" required>
                    <option value="">Selecciona un producto</option>
                </select>
                <small class="form-text search-status" role="status"></small>
                <input type="hidden" class="quoted-price" />
            </td>

            <td>
                <input type="number"
                       value="1"
                       min="1"
                       max="9999"
                       step="1"
                       required
                       aria-label="Cantidad"
                       class="form-control line-quantity" />
            </td>

            <td class="text-end text-nowrap line-price">
                —
            </td>

            <td class="text-end text-nowrap line-amount">
                —
            </td>

            <td class="text-end">
                <button type="button"
                        class="btn btn-sm btn-outline-danger remove-line">
                    Quitar
                </button>
            </td>
        </tr>
    </template>
</div>

@section Scripts
{
    <script src="~/js/orders/create.js"
            asp-append-version="true"></script>
}
