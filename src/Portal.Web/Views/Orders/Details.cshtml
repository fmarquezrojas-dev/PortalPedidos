@model Portal.Application.DTOs.Orders.OrderDetailDto

@using System.Globalization
@using Portal.Web.Formatting
@using Portal.Domain.Enums

@inject Portal.Application.Interfaces.Security.ICurrentUser CurrentUser

@{
    ViewData["Title"] = $"Pedido #{Model.Order.PublicNumber}";

    var culture = CultureInfo.GetCultureInfo("es-PE");

    bool canEditDraft =
        Model.Order.Status == OrderStatus.Draft &&
        CurrentUser.CanCreateOrders;

    bool canCopyRejected =
        Model.Order.Status == OrderStatus.Rejected &&
        CurrentUser.CanCreateOrders;
}

<div class="container-fluid py-4">
    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success" role="status">
            @successMessage
        </div>
    }

    <div class="d-flex flex-wrap justify-content-between
                align-items-center gap-3 mb-4">
        <div>
            <p class="section-kicker">GESTIÓN DE PEDIDOS</p>
            <h1 class="h3 mb-2">
                Pedido #@Model.Order.PublicNumber
            </h1>

            <partial name="_OrderStatus"
                     model="Model.Order.Status" />
        </div>

        <a asp-controller="Orders"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Volver a pedidos
        </a>
    </div>

    <div class="mb-3"><a asp-action="Print" asp-route-id="@Model.Order.Id" target="_blank" rel="noopener" class="btn btn-outline-primary">Resumen para imprimir / PDF</a></div>

    @if (canCopyRejected)
    {
        <div class="alert alert-warning mb-4" role="status">
            <p class="mb-2">
                Este pedido fue rechazado por el ERP.
                Puedes preparar un nuevo borrador con sus productos
                y los precios actuales del catálogo.
            </p>

            <p class="small mb-3">
                El pedido original conservará sus datos e historial.
                Crear la copia no la envía al ERP ni reserva existencias.
            </p>

            <a asp-controller="OrderCopies"
               asp-action="Index"
               asp-route-id="@Model.Order.Id"
               class="btn btn-outline-primary">
                Crear copia como borrador
            </a>
        </div>
    }

    @if (canEditDraft)
    {
        <div class="d-flex flex-wrap gap-2 mb-3">
            <a asp-controller="Orders"
               asp-action="Submit"
               asp-route-id="@Model.Order.Id"
               class="btn btn-primary">
                Revisar y enviar
            </a>

            <a asp-controller="Orders"
               asp-action="Edit"
               asp-route-id="@Model.Order.Id"
               class="btn btn-outline-primary">
                Editar borrador
            </a>

            <a asp-controller="Orders"
               asp-action="Cancel"
               asp-route-id="@Model.Order.Id"
               class="btn btn-outline-danger">
                Cancelar borrador
            </a>
        </div>
    }

    @if (Model.Order.Status == OrderStatus.Queued)
    {
        <div class="alert alert-info" role="status">
            El pedido está pendiente de integración.
            Todavía no tiene una confirmación definitiva del ERP.
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="small text-muted">
                        Cliente
                    </div>

                    <div class="fw-semibold">
                        @Model.Order.CustomerName
                    </div>

                    <div class="small">
                        @Model.Order.CustomerCode
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="small text-muted">
                        Fecha solicitada
                    </div>

                    <div>
                        @Model.RequestedDate.ToString("dd/MM/yyyy", culture)
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="small text-muted">
                        Moneda
                    </div>

                    <div>
                        @Model.Order.Currency
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="small text-muted">
                        Creado · Perú
                    </div>

                    <div>
                        @PortalDateTime.Format(Model.Order.CreatedAtUtc)
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="small text-muted">
                        Actualizado · Perú
                    </div>

                    <div>
                        @PortalDateTime.Format(Model.UpdatedAtUtc)
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="small text-muted">
                        Puesto en cola · Perú
                    </div>

                    <div>
                        @(Model.SubmittedAtUtc.HasValue
                            ? PortalDateTime.Format(Model.SubmittedAtUtc)
                            : "Todavía no enviado")
                    </div>

                    <div class="col-md-6">
    <div class="small text-muted">
        Equipo comercial
    </div>

    @if (Model.SalesTeamId.HasValue)
    {
        <div class="fw-semibold">
            @Model.SalesTeamName
        </div>

        <div class="small text-muted">
            @Model.SalesTeamCode
        </div>
    }
    else
    {
        <div class="text-muted">
            Sin equipo comercial asignado
        </div>
    }
</div>

                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white">
            <h2 class="h5 mb-0">
                Productos del pedido
            </h2>
        </div>

        <div class="card-body">
            @if (Model.Lines.Count == 0)
            {
                <p class="text-muted mb-0">
                    Este pedido todavía no tiene líneas registradas.
                </p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th scope="col">Línea</th>
                                <th scope="col">Código</th>
                                <th scope="col">Descripción</th>

                                <th scope="col" class="text-end">
                                    Cantidad
                                </th>

                                <th scope="col" class="text-end">
                                    Precio
                                </th>

                                <th scope="col" class="text-end">
                                    Importe
                                </th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var line in Model.Lines)
                            {
                                <tr>
                                    <td>
                                        @line.LineNumber
                                    </td>

                                    <td class="text-nowrap">
                                        @line.ItemCode
                                    </td>

                                    <td>
                                        @line.Description
                                    </td>

                                    <td class="text-end">
                                        @line.Quantity.ToString("0.####", culture)
                                    </td>

                                    <td class="text-end text-nowrap">
                                        @line.UnitPrice.ToString("0.00##", culture)
                                    </td>

                                    <td class="text-end text-nowrap">
                                        @line.LineAmount.ToString("N2", culture)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="text-end mt-3">
                <div class="small text-muted">
                    Importe referencial sin impuestos
                </div>

                <div class="h4 mb-0">
                    @Model.Order.Currency
                    @Model.Order.Subtotal.ToString("N2", culture)
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white">
            <h2 class="h5 mb-0">
                Referencia del ERP
            </h2>
        </div>

        <div class="card-body">
            <p>
                <strong>Sistema:</strong>
                @Model.Provider
            </p>

            <p class="mb-0">
                <strong>Referencia:</strong>

                @(string.IsNullOrWhiteSpace(Model.ExternalOrderId)
                    ? "Sin referencia asignada"
                    : Model.ExternalOrderId)
            </p>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <h2 class="h5 mb-0">
                Historial de estados
            </h2>
        </div>

        <div class="card-body">
            @if (Model.History.Count == 0)
            {
                <p class="text-muted mb-0">
                    No hay cambios de estado registrados.
                </p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">Fecha · Perú</th>
                                <th scope="col">Estado anterior</th>
                                <th scope="col">Nuevo estado</th>
                                <th scope="col">Motivo</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var entry in Model.History)
                            {
                                <tr>
                                    <td class="text-nowrap">
                                        @PortalDateTime.Format(entry.OccurredAtUtc)
                                    </td>

                                    <td>
                                        @if (entry.PreviousStatus.HasValue)
                                        {
                                            <partial name="_OrderStatus"
                                                     model="entry.PreviousStatus.Value" />
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Inicio
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <partial name="_OrderStatus"
                                                 model="entry.NewStatus" />
                                    </td>

                                    <td>
                                        @entry.Reason
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
