@model Portal.Web.Models.Orders.SubmitOrderViewModel

@using System.Globalization

@{
    ViewData["Title"] = "Confirmar envío";

    var culture = CultureInfo.GetCultureInfo("es-PE");
    var order = Model.Details.Order;
}

<div class="container py-4">
    <p class="section-kicker">GESTIÓN DE PEDIDOS</p>
            <h1 class="h3 mb-3">
        Confirmar envío del pedido #@order.PublicNumber
    </h1>

    <div asp-validation-summary="All"
         class="text-danger mb-3"
         role="alert"></div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-8">
                    <div class="small text-muted">Cliente</div>

                    <div class="fw-semibold">
                        @order.CustomerName
                    </div>

                    <div class="small">
                        @order.CustomerCode
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="small text-muted">
                        Fecha solicitada
                    </div>

                    <div>
                        @Model.Details.RequestedDate.ToString("dd/MM/yyyy")
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th scope="col">Producto</th>
                            <th scope="col" class="text-end">Cantidad</th>
                            <th scope="col" class="text-end">Precio</th>
                            <th scope="col" class="text-end">Importe</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var line in Model.Details.Lines)
                        {
                            <tr>
                                <td>
                                    <div>@line.Description</div>
                                    <div class="small text-muted">
                                        @line.ItemCode
                                    </div>
                                </td>

                                <td class="text-end">
                                    @line.Quantity.ToString("0.####", culture)
                                </td>

                                <td class="text-end">
                                    @line.UnitPrice.ToString("0.00##", culture)
                                </td>

                                <td class="text-end">
                                    @line.LineAmount.ToString("N2", culture)
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="text-end">
                <div class="small text-muted">
                    Importe referencial sin impuestos
                </div>

                <div class="h4 mb-0">
                    @order.Currency
                    @order.Subtotal.ToString("N2", culture)
                </div>
            </div>
        </div>
    </div>

    @if (!Model.CanSubmit)
    {
        <div class="alert alert-warning">
            Este pedido ya no está en estado Borrador.
            Consulta su estado actual en el detalle.
        </div>

        <a asp-controller="Orders"
           asp-action="Details"
           asp-route-id="@Model.Id"
           class="btn btn-outline-secondary">
            Volver al pedido
        </a>
    }
    else if (Model.CustomerOutsidePortfolio)
    {
        <p>El borrador conserva sus líneas y cantidades.</p>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar borrador</a>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Volver al pedido</a>
    }
    else
    {
        <div class="alert alert-warning">
            <strong>
                Después de confirmar no podrás editar ni cancelar
                este pedido desde el portal.
            </strong>

            <p class="mb-0 mt-2">
                El pedido quedará pendiente de integración.
                El ERP validará la disponibilidad definitiva
                y devolverá su aceptación o rechazo.
            </p>
        </div>

        <form asp-controller="Orders"
              asp-action="Submit"
              asp-route-id="@Model.Id"
              asp-antiforgery="true"
              method="post">

            <input asp-for="Id" type="hidden" />
            <input asp-for="RowVersion" type="hidden" />

            <div class="form-check mb-3">
                <input asp-for="ConfirmSubmission"
                       class="form-check-input"
                       required />

                <label asp-for="ConfirmSubmission"
                       class="form-check-label">
                    Revisé el cliente, los productos, las cantidades
                    y el importe. Confirmo el envío.
                </label>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary">
                    Confirmar envío
                </button>

                <a asp-controller="Orders"
                   asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-secondary">
                    Volver sin enviar
                </a>
            </div>

            <div class="mt-3">
                <a asp-controller="Orders"
                   asp-action="Submit"
                   asp-route-id="@Model.Id">
                    Recargar confirmación
                </a>
            </div>
        </form>
    }
</div>
