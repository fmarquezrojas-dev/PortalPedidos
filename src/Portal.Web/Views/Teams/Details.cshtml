@model Portal.Application.DTOs.Teams.SalesTeamDetailDto

@using System
@using Portal.Web.Formatting

@{
    ViewData["Title"] = Model.Name;

    string rowVersion = Convert.ToBase64String(Model.RowVersion);
}

<div class="container-fluid py-4">
    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success" role="status">
            @successMessage
        </div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-warning" role="alert">
            @errorMessage
        </div>
    }

    <div class="d-flex flex-wrap justify-content-between
                align-items-center gap-3 mb-4">
        <div>
            <div class="small text-muted">@Model.Code</div>
            <p class="section-kicker">ORGANIZACIÓN COMERCIAL</p>
            <h1 class="h3 mb-2">@Model.Name</h1>

            @if (Model.IsActive)
            {
                <span class="badge bg-success">Activo</span>
            }
            else
            {
                <span class="badge bg-secondary">Inactivo</span>
            }
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Volver a equipos
        </a>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-8">
                    <div class="small text-muted">Supervisor</div>
                    <div class="fw-semibold">
                        @Model.SupervisorEmail
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="small text-muted">
                        Asignaciones vigentes
                    </div>
                    <div class="fw-semibold">
                        @Model.MemberCount / 50
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (Model.CanManage)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white">
                <h2 class="h5 mb-0">Incorporar vendedor</h2>
            </div>

            <div class="card-body">
                <form asp-action="AddMember"
                      asp-route-id="@Model.Id"
                      method="post"
                      asp-antiforgery="true"
                      class="row g-3 align-items-end">

                    <input type="hidden"
                           name="TeamId"
                           value="@Model.Id" />

                    <input type="hidden"
                           name="RowVersion"
                           value="@rowVersion" />

                    <div class="col-md-8">
                        <label for="seller-email"
                               class="form-label">
                            Correo del vendedor
                        </label>

                        <input id="seller-email"
                               name="SellerEmail"
                               type="email"
                               maxlength="256"
                               class="form-control"
                               required />

                        <div class="form-text">
                            Cuenta activa con rol Vendedor y
                            sin otra asignación vigente.
                        </div>
                    </div>

                    <div class="col-md-4">
                        <button type="submit"
                                class="btn btn-primary">
                            Incorporar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white">
            <h2 class="h5 mb-0">Vendedores del equipo</h2>
        </div>

        <div class="card-body">
            @if (Model.Members.Count == 0)
            {
                <p class="text-muted mb-0">
                    El equipo todavía no tiene vendedores asignados.
                </p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th scope="col">Vendedor</th>
                                <th scope="col">Cuenta</th>
                                <th scope="col">Ingreso · Perú</th>

                                @if (Model.CanManage)
                                {
                                    <th scope="col">Acción</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var member in Model.Members)
                            {
                                <tr>
                                    <td>@member.Email</td>

                                    <td>
                                        @if (member.UserIsActive)
                                        {
                                            <span class="badge bg-success">
                                                Activa
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Inactiva
                                            </span>
                                        }
                                    </td>

                                    <td class="text-nowrap">
                                        @PortalDateTime.Format(member.JoinedAtUtc)
                                    </td>

                                    @if (Model.CanManage)
                                    {
                                        <td>
                                            <form asp-action="RemoveMember"
                                                  asp-route-id="@Model.Id"
                                                  method="post"
                                                  asp-antiforgery="true">

                                                <input type="hidden"
                                                       name="TeamId"
                                                       value="@Model.Id" />

                                                <input type="hidden"
                                                       name="MembershipId"
                                                       value="@member.MembershipId" />

                                                <input type="hidden"
                                                       name="RowVersion"
                                                       value="@rowVersion" />

                                                <div class="form-check mb-2">
                                                    <input type="checkbox"
                                                           id="remove-@member.MembershipId"
                                                           name="ConfirmRemoval"
                                                           value="true"
                                                           class="form-check-input"
                                                           required />

                                                    <label for="remove-@member.MembershipId"
                                                           class="form-check-label small">
                                                        Confirmo el retiro
                                                    </label>
                                                </div>

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger">
                                                    Retirar del equipo
                                                </button>
                                            </form>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <p class="small text-muted mt-3 mb-0">
                Retirar una asignación conserva su historial.
                No desactiva la cuenta ni cambia los pedidos existentes.
            </p>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <h2 class="h5 mb-0">Últimos 20 retiros</h2>
        </div>

        <div class="card-body">
            @if (Model.RecentDepartures.Count == 0)
            {
                <p class="text-muted mb-0">
                    No hay retiros registrados.
                </p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">Vendedor</th>
                                <th scope="col">Ingreso · Perú</th>
                                <th scope="col">Retiro · Perú</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var member in Model.RecentDepartures)
                            {
                                <tr>
                                    <td>@member.Email</td>
                                    <td>
                                        @PortalDateTime.Format(member.JoinedAtUtc)
                                    </td>
                                    <td>
                                        @PortalDateTime.Format(member.LeftAtUtc)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>