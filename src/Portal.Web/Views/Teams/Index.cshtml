@model Portal.Application.DTOs.Teams.SalesTeamPageDto

@{
    ViewData["Title"] = "Equipos comerciales";
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between
                align-items-center gap-3 mb-4">
        <div>
            <p class="section-kicker">ORGANIZACIÓN COMERCIAL</p>
            <h1 class="h3 mb-2">Equipos comerciales</h1>

            <p class="text-muted mb-0">
                Consulta los equipos que tienes autorización para ver.
            </p>
        </div>

        @if (Model.CanCreate)
        {
            <a asp-action="Create"
               class="btn btn-primary">
                Crear equipo
            </a>
        }
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <p class="text-muted">
                Equipos encontrados: @Model.TotalCount
            </p>

            @if (Model.Items.Count == 0)
            {
                <div class="text-center border rounded p-5">
                    <h2 class="h5">No hay equipos para mostrar</h2>

                    <p class="text-muted mb-0">
                        Los equipos disponibles para tu cuenta
                        aparecerán aquí.
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th scope="col">Código</th>
                                <th scope="col">Equipo</th>
                                <th scope="col">Supervisor</th>
                                <th scope="col">Estado</th>
                                <th scope="col" class="text-end">
                                    Vendedores
                                </th>
                                <th scope="col" class="text-end">
                                    Acción
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="fw-semibold">@item.Code</td>
                                    <td>@item.Name</td>
                                    <td>@item.SupervisorEmail</td>
                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Inactivo
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @item.MemberCount
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Ver equipo
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="d-flex justify-content-between
                        align-items-center gap-3 mt-3">
                <span class="text-muted">
                    Página @Model.PageNumber de @Model.TotalPages
                </span>

                <div class="d-flex gap-2">
                    @if (Model.HasPreviousPage)
                    {
                        <a asp-action="Index"
                           asp-route-pageNumber="@(Model.PageNumber - 1)"
                           class="btn btn-outline-primary">
                            Anterior
                        </a>
                    }

                    @if (Model.HasNextPage)
                    {
                        <a asp-action="Index"
                           asp-route-pageNumber="@(Model.PageNumber + 1)"
                           class="btn btn-outline-primary">
                            Siguiente
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>